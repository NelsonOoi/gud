{
  "id": "protected-approval",
  "title": "A protected interface change needs the owner's approval",
  "note": "api.py is explicit. @bob owns it (genesis author). Git has no protection and can push the same edit directly; that difference is the comparison.",
  "window_seconds": 5,
  "genesis_author": "@bob",
  "protected": "api.py explicit",
  "limits": {"max_turns": 12, "wait_seconds": 20},
  "min_links": 2,
  "tree": {
    "api.py": "def get_user(id):\n    return {\"id\": id}\n"
  },
  "expect": {
    "api.py": "def get_user(user_id):\n    return {\"id\": user_id}\n"
  },
  "agents": [
    {
      "handle": "@alice",
      "instructions": "Rename the parameter of get_user in api.py from id to user_id. Keep the same return. The file is protected: land the change, getting approval if the tool says you need it.",
      "gud_script": [
        {"tool": "push", "args": {"intent": "rename get_user parameter to user_id", "edits": [{"path": "api.py", "old": "def get_user(id):\n    return {\"id\": id}\n", "new": "def get_user(user_id):\n    return {\"id\": user_id}\n"}]}},
        {"settle": "gud"},
        {"expect_prefix": "landed"}
      ],
      "git_script": [
        {"tool": "write", "args": {"path": "api.py", "content": "def get_user(user_id):\n    return {\"id\": user_id}\n"}},
        {"tool": "git_commit", "args": {"message": "rename get_user parameter to user_id"}},
        {"settle": "git"},
        {"expect_prefix": "pushed"}
      ]
    },
    {
      "handle": "@bob",
      "instructions": "You own api.py. Approve a push that only renames get_user's parameter from id to user_id. Object to any other change.",
      "gud_script": [
        {"poll_needs_me": true, "timeout": 15},
        {"tool": "reply", "args": {"target": "$target", "action": "approve", "reason": "parameter rename only"}}
      ],
      "git_script": [
        {"tool": "git_status"}
      ]
    }
  ]
}
